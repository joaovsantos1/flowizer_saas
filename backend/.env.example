# ============================================
# ENVIRONMENT VARIABLES - NEVER COMMIT .env
# ============================================

# App
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com

# Security
JWT_SECRET=replace_with_256bit_random_secret_minimum_32chars
JWT_REFRESH_SECRET=replace_with_different_256bit_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes256
ENCRYPTION_IV_LENGTH=16

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_saas
DB_USER=saas_user
DB_PASSWORD=replace_with_strong_password
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace_with_redis_password

# WhatsApp (Evolution API)
WA_PROVIDER=evolution
EVOLUTION_API_URL=https://evolution.yourdomain.com
EVOLUTION_API_KEY=replace_with_evolution_api_key
EVOLUTION_WEBHOOK_SECRET=replace_with_webhook_secret

# WhatsApp (Meta API - alternative)
META_VERIFY_TOKEN=replace_with_meta_verify_token
META_ACCESS_TOKEN=replace_with_meta_access_token
META_PHONE_NUMBER_ID=replace_with_phone_number_id
META_APP_SECRET=replace_with_meta_app_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_replace_with_price_id
STRIPE_TRIAL_DAYS=7

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace_with_openai_key
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WEBHOOK_MAX=50

# n8n → Backend (canal interno)
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
N8N_INTERNAL_SECRET=replace_with_96hex_chars_random_secret_min_32chars
# IPs da VPS permitidos a chamar /internal/* (separados por vírgula, vazio = apenas token)
N8N_ALLOWED_IPS=172.20.0.0,127.0.0.1

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Backup
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=replace_with_aws_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret
AWS_REGION=us-east-1
